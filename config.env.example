# Opcional — para sentimiento de Reddit (reddit_sentiment). Sin esto, esa
# herramienta puntual no funciona pero el resto del bot sigue andando normal.
# Cómo conseguirlo: pedir acceso a la Data API (uso no comercial) en
# https://support.reddithelp.com/hc/en-us/requests/new?ticket_form_id=14868593862164
# y crear una app tipo "script" en https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Tu usuario de Reddit (sin "u/"). Reddit exige que el User-Agent lo incluya.
REDDIT_USERNAME=

# Opcional — fuente paga de datos de empresa (noticias_empresa, screener_empresas).
